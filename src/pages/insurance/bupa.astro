---
/**
 * /insurance/bupa/ — Bupa cover at the Clapham clinic.
 *
 * One of six insurer pages. Each has a route file of its own rather than a
 * [slug].astro, matching how the service pages are built, which also keeps
 * the sitemap honest: it is generated by globbing these page files, so an
 * insurer can never appear in the sitemap without a page actually existing.
 *
 * Everything on the page comes from Sanity -> Insurance -> Bupa.
 * insurance.required() throws on a missing document rather than deploying an
 * empty page over a working one.
 *
 * These pages are deliberately text-only: the brief supplied no photography
 * for them, so ContentSections renders each section as a prose band. Adding an
 * image to a section in Sanity switches it to the two-column layout with no
 * change here.
 */
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ContentSections from '../../components/ContentSections.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import RichText from '../../components/RichText.astro';
import { insurance } from '../../lib/sanity/pageContent';

const doc = await insurance.required('bupa');

const faqs = doc.faqs.map((f) => ({ q: f.question, a: f.answer }));
---
<Layout
	title={doc.seoTitle ?? "Bupa Physio in Clapham | Balance Performance Physiotherapy"}
	description={doc.seoDescription ?? "Bupa physiotherapy in Clapham, SW4. We are recognised by Bupa and welcome Bupa Global members. Contact us with your pre-authorisation to book."}
>
	<PageHero
		title={doc.heroHeading}
		highlight={doc.heroHighlight ?? undefined}
		breadcrumb={doc.breadcrumb ?? undefined}
	/>

	<ContentSections sections={doc.sections} />

	{faqs.length > 0 && (
		<section class="faq-section faq-section--alt">
			<div class="container">
				<div class="section-header"><h2>Bupa Physiotherapy FAQs</h2></div>
				<div class="faq-list">
					{faqs.map((item) => (
						<details class="faq-item">
							<summary>{item.q}</summary>
							<div class="answer"><RichText blocks={item.a} /></div>
						</details>
					))}
				</div>
			</div>
		</section>
	)}

	<BookingCTA />
</Layout>
